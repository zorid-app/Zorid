    {
      "id": "natural-zero-and-path-ties",
      "kind": "query-order",
      "view": {
        "sort": [
          {
            "property": "label",
            "direction": "ASC"
          }
        ]
      },
      "records": [
        {
          "path": "z.md",
          "properties": {
            "label": "item02"
          }
        },
        {
          "path": "a.md",
          "properties": {
            "label": "ITEM2"
          }
        },
        {
          "path": "b.md",
          "properties": {
            "label": "item10"
          }
        },
        {
          "path": "c.md",
          "properties": {
            "label": "item2a"
          }
        }
      ],
      "expected": {
        "paths": [
          "a.md",
          "z.md",
          "c.md",
          "b.md"
        ]
      },
      "decision": "approved-portable-natural-comparator",
      "note": "Equal digit runs ignore zero padding; exact path breaks a complete label tie. Text after a numeric run still participates."
    },
    {
      "id": "boolean-null-last-desc",
      "kind": "query-order",
      "view": {
        "sort": [
          {
            "property": "key",
            "direction": "DESC"
          }
        ]
      },
      "records": [
        {
          "path": "a.md",
          "properties": {
            "key": null
          }
        },
        {
          "path": "b.md",
          "properties": {
            "key": false
          }
        },
        {
          "path": "c.md",
          "properties": {
            "key": true
          }
        }
      ],
      "expected": {
        "paths": [
          "c.md",
          "b.md",
          "a.md"
        ]
      },
      "decision": "approved-null-last-before-boolean"
    },
